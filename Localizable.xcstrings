          }
        }
      }
    },
    "iCloud Drive n'est pas activé sur ce Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive isn't turned on on this Mac."
          }
        }
      }
    },
    "l'application": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the app"
          }
        }
      }
    },
    "le coin %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the %@ corner"
          }
        }
      }
    },
    "macOS réserve le contenu de la corbeille aux applications qui ont l'« Accès complet au disque ». Ouvre le réglage, active Side dans la liste, puis relance Side : la corbeille s'affichera dans la carte.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS only lets apps with Full Disk Access see what's in the Trash. Open the setting, turn on Side in the list, then reopen Side: the Trash will show in the card."
          }
        }
      }
    },
    "pas de réponse": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "no response"
          }
        }
      }
    },
    "quatre doigts %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
